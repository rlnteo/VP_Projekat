<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
	</startup>

	<system.serviceModel>
		<client>
			<endpoint name="ChargingService"
					  address="net.tcp://localhost:4001/ChargingService"
					  binding="netTcpBinding"
					  bindingConfiguration="ChargingBinding"
					  contract="Common.IChargingService" />
		</client>
		<bindings>
			<netTcpBinding>
				<binding name="ChargingBinding"
						 maxReceivedMessageSize="10485760"
						 sendTimeout="00:30:00"
						 receiveTimeout="00:30:00"
						 openTimeout="00:30:00"
						 closeTimeout="00:30:00">
					<security mode="None" />
				</binding>
			</netTcpBinding>
		</bindings>
	</system.serviceModel>
</configuration>